GITLAB_TOKEN=your-gitlab-token
GITLAB_HOST=git.yourdomain.tld

GITHUB_TOKEN=your-github-token

#COMPOSER_AUTH={"http-basic":{"repo.example.com":{"username":"user","password":"pass"}}}
COMPOSER_AUTH_B64=COMPOSER_AUTH|base64

DOCKER_REGISTRY_HOST=registry.yourdomain.tld
DOCKER_REGISTRY_USER=your-registry-username
DOCKER_REGISTRY_TOKEN=your-registry-token

XCLAUDE_AUTH_TOKEN=your-xclaude-gateway-token
XCLAUDE_BASE_URL=llm.yourdomain.tld
XCLAUDE_MODEL=cx/gpt-5.6-terra
XCLAUDE_SMALL_MODEL=cx/gpt-5.6-terra
XCLAUDE_EFFORT=high
XCLAUDE_PERMISSION_MODE=true
XCLAUDE_BYPASS=false
